# ==============================================================================
# Vingo CRM — Environment Variable Configuration Template
# ==============================================================================
# Copy this file to '.env' or '.env.local' and provide your values.
# Note: In development mode, if these values are empty, the app runs smoothly
# using an interactive in-memory / pre-seeded company dataset (11–50 employees).

# --- Supabase Cloud / Self-Hosted Configuration ---
# Your Supabase project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase public anonymous API key (safe for browser distribution)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# --- Application Settings (Optional) ---
# Company title displayed in header and documents
VITE_APP_COMPANY_NAME="Vingo Technologies Inc."

# Primary Founder / Executive Administrator Email (configured during initial setup)
VITE_FOUNDER_EMAIL=founder@yourcompany.internal

# Environment name ('development' | 'staging' | 'production')
VITE_APP_ENV=development

# Optional Edge Function endpoints
# VITE_SUPABASE_FUNCTIONS_URL=https://your-project.supabase.co/functions/v1

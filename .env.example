# ==============================================================================
# Vingo CRM — Environment Variable Configuration Template
# ==============================================================================
# Copy this file to '.env' or '.env.local' and provide your values.
# Note: In development/demo mode, if these values are empty, the app runs smoothly
# using an interactive in-memory / pre-seeded company dataset (11–50 employees).

# --- Client-Facing Supabase Configuration (Safe for Browser) ---
# Your Supabase project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase public anonymous API key (Read/Write restricted strictly by RLS)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# --- Application Settings ---
# Company title displayed in header and documents
VITE_APP_COMPANY_NAME="Vingo Technologies Inc."

# Primary Founder / Executive Administrator Email
VITE_FOUNDER_EMAIL=founder@yourcompany.internal

# Environment name ('development' | 'staging' | 'production')
VITE_APP_ENV=production

# Application Base URL
VITE_APP_URL=https://vingo-crm.vercel.app

# --- SERVER-SIDE ONLY SECRETS (DO NOT PREFIX WITH VITE_) ---
# These variables MUST NEVER be prefixed with VITE_ or exposed to the client bundle.
# Configure these directly in Supabase Dashboard -> Project Settings -> Edge Functions Secrets:
#
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi... (Edge functions only)
# EMAIL_WEBHOOK_SECRET=your_hmac_sha256_webhook_signing_secret
# GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# MICROSOFT_CLIENT_SECRET=your_microsoft_oauth_client_secret
# SENTRY_AUTH_TOKEN=your_sentry_release_token
